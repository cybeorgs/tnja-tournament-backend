# PostgreSQL database used only by the tournament app
DATABASE_URL="postgresql://tnja:password@localhost:5433/tnja_tournament?schema=public"

PORT=9100
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS="http://localhost:3100"

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Used by `npm run admin:create` (and on first boot when no admin exists yet)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# Razorpay (optional — online payment is disabled when blank)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Public site address, printed on certificates as "Verify at <url>/verify/<number>"
PUBLIC_SITE_URL="http://localhost:3100"

# SMTP for email verification codes on student registration.
# Port 465 uses implicit TLS; other ports (e.g. 587) use STARTTLS.
# When blank (and NODE_ENV isn't "production"), codes are printed to the server console instead.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
# Sender address (must be verified with providers like Brevo); defaults to SMTP_USER
SMTP_FROM_EMAIL=""
# Defaults to the organisation name from Settings
SMTP_FROM_NAME=""
