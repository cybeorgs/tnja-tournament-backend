# PostgreSQL database used only by the tournament app
DATABASE_URL="postgresql://tnja:password@localhost:5433/tnja_tournament?schema=public"

PORT=9100
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS="http://localhost:3100"

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Used by `npm run admin:create` (and on first boot when no admin exists yet)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# Razorpay (optional — online payment is disabled when blank)

# Public site address, printed on certificates as "Verify at <url>/verify/<number>"
PUBLIC_SITE_URL="http://localhost:3100"

# ── Email ──
# Where emails go: "smtp" (really sent) or "console" (written to the server log, nothing sent).
# Unset: SMTP on a production deployment (NODE_ENV=production, or PUBLIC_SITE_URL an https address that
# isn't localhost), the console everywhere else. SET THIS TO smtp EXPLICITLY ON THE PRODUCTION SERVER.
# On a development machine leave it unset, and don't put production SMTP credentials in its .env.
EMAIL_TRANSPORT=""
# Development only, with EMAIL_TRANSPORT=smtp: the only addresses really emailed (comma-separated
# emails or @domains). Everyone else goes to the console. Use your own test mailbox or a test SMTP.
EMAIL_DEV_ALLOWLIST=""

# Daily email limits per type (reset at midnight India time). Empty = no limit (still counted and shown
# on Admin → Emails); 0 = that type is switched off. Over the limit, registration/approval emails and
# entry passes are HELD for an admin to release (nothing is dropped); verification codes and password
# resets are refused with "try again later". Choose numbers from your plan, e.g. 5,000 a month ≈ 160 a day.
EMAIL_DAILY_LIMIT_OTP=""
EMAIL_DAILY_LIMIT_REGISTRATION=""
EMAIL_DAILY_LIMIT_ENTRY_PASS=""
EMAIL_DAILY_LIMIT_PASSWORD_RESET=""
EMAIL_DAILY_LIMIT_ADMIN=""

# SMTP (Brevo). Port 465 uses implicit TLS; other ports (e.g. 587) use STARTTLS.
# Give this app its own Brevo SMTP key (Brevo → SMTP & API → SMTP keys), not the main TNJA site's.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
# Sender address (must be verified with providers like Brevo); defaults to SMTP_USER
SMTP_FROM_EMAIL=""
# Defaults to the organisation name from Settings
SMTP_FROM_NAME=""

# Email verification codes per network (IP). Per email it's fixed: 3 codes per 15 minutes, with
# 3 minutes between resends. Raise these if a club registers many players from one office.
# OTP_PER_IP_HOUR=10
# OTP_PER_IP_DAY=30

# Brevo webhook (Transactional → Settings → Webhooks): hard bounces, blocked, invalid, spam and
# unsubscribe events add the address to the suppression list, so it is never emailed again. Register
#   https://<api host>/api/public/email-events/brevo?token=<this value>
# or the same URL without ?token= and bearer authentication with this value. Leave blank to switch it off.
BREVO_WEBHOOK_TOKEN=""

# ── Aadhaar verification via DigiLocker (Sandbox, https://developer.sandbox.co.in) ──
# Self-registering students verify their Aadhaar in DigiLocker, and the pincode on the Aadhaar address
# must match the pincode they entered. Switched off (not required) unless key and secret are set.
# Can share the main TNJA site's Sandbox account; DigiLocker must be enabled for it.
SANDBOX_BASE_URL=https://api.sandbox.co.in
SANDBOX_API_KEY=""
SANDBOX_API_SECRET=""
SANDBOX_API_VERSION=1.0.0
# Page DigiLocker returns to after consent; must be public HTTPS.
# Defaults to PUBLIC_SITE_URL/digilocker-callback when that is https, else the main TNJA site's page.
# DIGILOCKER_REDIRECT_URL=https://tournament.example.in/digilocker-callback
# Most DigiLocker sessions started per day across all users (each one is billed); 0 = no cap.
AADHAAR_DAILY_LIMIT=500
# Most DigiLocker sessions one Aadhaar number may start per day; 0 = no cap.
AADHAAR_PER_NUMBER_DAILY_LIMIT=6
# Hard cap on ALL billed Sandbox calls per day (IST), retries included: a successful verification
# costs ~3 (init + status + document). Set it to what you are willing to spend; 0 = no cap.
SANDBOX_DAILY_CALL_LIMIT=2000
