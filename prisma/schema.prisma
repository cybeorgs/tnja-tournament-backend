generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Accounts that can log in and run tournaments. There is no approval chain:
/// any admin has full control over every tournament.
model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  name         String   @default("Administrator")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Single-row white-label settings (id is always "default").
model Settings {
  id              String   @id @default("default")
  orgName         String   @default("Tamil Nadu Judo Association")
  orgShortName    String   @default("TNJA")
  tagline         String   @default("Affiliated to Judo Federation of India")
  /// Society registration number, shown next to the name on the site and on every PDF
  regNo           String   @default("329-2017")
  signatory1Name  String   @default("")
  signatory1Title String   @default("President")
  signatory2Name  String   @default("")
  signatory2Title String   @default("Secretary")
  logo            Bytes?
  logoMime        String?
  updatedAt       DateTime @updatedAt
}

model Tournament {
  id               String    @id @default(uuid())
  slug             String    @unique
  title            String
  description      String    @default("")
  venue            String
  city             String    @default("")
  /// Date and time the tournament starts. Registration (and paying for it) closes at this moment.
  startDate        DateTime
  endDate          DateTime?
  /// Registration opens at this moment, at the regular entry fee
  registrationOpensAt  DateTime
  /// Regular registration ends here; late registration (2 × entry fee) runs from here until startDate
  registrationClosesAt DateTime
  /// When to email the deadline reminder to players with unpaid entries (before registrationClosesAt); null = no reminder
  reminderAt       DateTime?
  /// DISTRICT | STATE | ZONAL | NATIONAL | OPEN
  level            String    @default("STATE")
  /// MALE | FEMALE | BOTH
  gender           String    @default("BOTH")
  /// Age groups contested, e.g. ["Sub-Junior", "Cadet"]
  ageGroups        String[]
  /// Fee for a player's first category (age group) in the tournament
  entryFee         Int       @default(0)
  /// Fee for each further category the same player enters (at most entryFee; 0 = extra categories free)
  additionalEntryFee Int     @default(0)
  /// Late entry fee set by the admin, higher than entryFee (registrationClosesAt → startDate)
  lateEntryFee     Int       @default(0)
  numberOfMats     Int       @default(1)
  /// PUBLISHED (public page live; set on creation) | COMPLETED
  status           String    @default("PUBLISHED")
  publishedAt      DateTime?
  /// When true the public page shows placements and certificates can be downloaded publicly.
  resultsPublished Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  registrations Registration[]
  referees      TournamentReferee[]
  draws         Draw[]
  emails        EmailLog[]
}

/// Master list of athletes, reusable across tournaments.
model Student {
  id               String   @id @default(uuid())
  /// Permanent student ID, e.g. TNJA-S-000123. Issued straight away for Tamil Nadu residents and
  /// on admin approval for everyone else (null until then). It never changes.
  studentNo        String?  @unique
  /// APPROVED | PENDING (outside Tamil Nadu, waiting for the admin to check their documents) | REJECTED
  status           String   @default("APPROVED")
  /// Residing pincode is outside Tamil Nadu: they upload proof (e.g. a nativity certificate) and need approval
  outsideTamilNadu Boolean  @default(false)
  /// Admin's note when rejecting an application
  reviewNote       String   @default("")
  reviewedAt       DateTime?
  fullName         String
  fatherName       String   @default("")
  motherName       String   @default("")
  dob              DateTime
  /// MALE | FEMALE. (Older records may be OTHER: they choose boys' or girls' categories per tournament.)
  gender           String
  club             String   @default("")
  /// Residing / studying district
  district         String   @default("")
  belt             String   @default("")
  phone            String   @default("")
  // ── Registration details (see studentSchema in src/lib/students.ts) ──
  taluk            String   @default("")
  residingPincode  String   @default("")
  bloodGroup       String   @default("")
  /// 12 digits; unique so one person can't hold two student IDs
  aadhaarNumber    String?  @unique
  alternatePhone   String   @default("")
  /// Parent or guardian's mobile (printed on the registration PDF and hall ticket)
  parentPhone      String   @default("")
  /// Who to call in an emergency
  emergencyPhone   String   @default("")
  /// Lower-case. Students sharing an email (e.g. siblings) share one StudentAccount login.
  email            String   @default("")
  nationality      String   @default("")
  address          String   @default("")
  city             String   @default("")
  state            String   @default("")
  pincode          String   @default("")
  annualIncome     Int?
  /// Below poverty line; Tamil Nadu residents upload proof when registering themselves
  isBPL            Boolean  @default(false)
  /// STUDENT | PROFESSIONAL (working professional). Both play the same age and weight categories
  /// and pay the same fees; only the education / occupation details differ.
  participantType  String   @default("STUDENT")
  // ── Education (students) ──
  /// SCHOOL | COLLEGE | DIPLOMA
  institutionType  String   @default("")
  institutionName  String   @default("")
  /// Standard (school) or year (college / diploma)
  grade            String   @default("")
  degreeDepartment String   @default("")
  // ── Occupation (working professionals) ──
  /// PRIVATE | GOVERNMENT | SELF_EMPLOYED | OTHER
  employmentType   String   @default("")
  /// Employer / organisation (or business name when self-employed)
  organisationName String   @default("")
  /// Designation / role
  occupation       String   @default("")
  coachName        String   @default("")
  // ── Additional details (printed on the hall ticket) ──
  /// Body weight given at registration, kg (each tournament entry records its own weight too)
  weightKg          Float?
  managerName       String   @default("")
  districtPresident String   @default("")
  districtSecretary String   @default("")
  /// SELF (public registration form) | ADMIN
  source           String   @default("ADMIN")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  registrations Registration[]
  documents     StudentDocument[]

  @@index([email])
  @@index([status])
  @@index([participantType])
}

/// Files uploaded with a registration: the passport-size photo, BPL proof, or proof of nativity for applicants outside Tamil Nadu.
model StudentDocument {
  id        String   @id @default(uuid())
  studentId String
  /// PHOTO | BPL_PROOF | NATIVITY_PROOF
  kind      String
  /// What the applicant says the file is, e.g. "Nativity certificate"
  label     String   @default("")
  mime      String
  data      Bytes
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, kind])
}

/// Login for students (and parents): one per email, covering every student registered with it.
model StudentAccount {
  id           String   @id @default(uuid())
  /// Lower-case
  email        String   @unique
  passwordHash String
  /// When the owner chose a password; null while only the emailed set-password link can be used
  passwordSetAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Registration {
  id                String    @id @default(uuid())
  tournamentId      String
  studentId         String
  ageGroup          String
  /// MALE | FEMALE: the categories competed in, copied so a category never changes underneath a draw.
  gender            String
  weightKg          Float
  weightCategory    String
  /// PENDING (not weighed yet) | CLEARED (scale weight is within weightCategory) | DISQUALIFIED (left out of the draw).
  /// A category's draw can only be generated once none of its entrants is PENDING.
  weighInStatus     String    @default("PENDING")
  /// Scale weight recorded at the weigh-in
  weighInKg         Float?
  weighedAt         DateTime?
  /// FIRST | SECOND | THIRD | PARTICIPATION — set when the category is concluded
  placement         String?
  /// Unique, hard-to-guess number printed on the certificate and used for public verification
  certificateNo     String?   @unique
  /// PENDING | PAID | WAIVED
  paymentStatus     String    @default("PENDING")
  /// Entered during late registration (registration type: Late; otherwise Regular)
  isLate            Boolean   @default(false)
  /// Amount due while unpaid: the fee of the current period (entry fee, or the late entry fee once the
  /// regular deadline has passed). Kept up to date for unpaid entries; frozen once paid.
  fee               Int       @default(0)
  /// RAZORPAY | CASH | UPI | OTHER
  paymentMode       String?
  /// Actual amount received (for online payments, as verified with the payment gateway)
  amountPaid        Int       @default(0)
  razorpayOrderId   String?
  /// The amount this entry was charged in its current payment order, checked against the gateway on verification
  orderFee          Int?
  razorpayPaymentId String?
  paidAt            DateTime?
  /// Registration confirmation email sent (so it goes out once per entry)
  confirmationSentAt DateTime?
  /// Deadline reminder email sent (so it goes out once per entry)
  reminderSentAt     DateTime?
  /// Tournament Entry Pass for this event emailed (the column keeps its earlier "hall ticket" name)
  hallTicketSentAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)

  /// A student may enter several age groups (e.g. a cadet in Cadet, Junior and Senior), one entry each.
  @@unique([tournamentId, studentId, ageGroup])
  @@index([tournamentId, ageGroup, gender, weightCategory])
  @@index([razorpayOrderId])
  @@index([tournamentId, weighInStatus])
}

/// Master list of referees and technical officials.
model Referee {
  id        String   @id @default(uuid())
  fullName  String
  /// e.g. "International", "National A", "State"
  grade     String   @default("")
  district  String   @default("")
  phone     String   @default("")
  email     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments TournamentReferee[]
}

model TournamentReferee {
  id            String   @id @default(uuid())
  tournamentId  String
  refereeId     String
  /// REFEREE | JUDGE | TIMEKEEPER | SCOREKEEPER | TECHNICAL_OFFICIAL
  role          String   @default("REFEREE")
  matNumber     Int?
  certificateNo String   @unique
  createdAt     DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  referee    Referee    @relation(fields: [refereeId], references: [id], onDelete: Restrict)

  @@unique([tournamentId, refereeId])
}

/// One bracket per category. There is exactly one row per category, so lookups by
/// (ageGroup, gender, weightCategory) are never ambiguous.
model Draw {
  id             String    @id @default(uuid())
  tournamentId   String
  ageGroup       String
  gender         String
  weightCategory String
  /// ELIMINATION | ROUND_ROBIN
  format         String
  matNumber      Int       @default(1)
  /// Entrant[] (registration id, name, club) in the order they were drawn
  entrants       Json
  /// Match[][] — see src/lib/bracket.ts
  rounds         Json
  isConcluded    Boolean   @default(false)
  concludedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, ageGroup, gender, weightCategory])
}

/// Every automated or admin-triggered tournament email, with its delivery status.
model EmailLog {
  id           String   @id @default(uuid())
  tournamentId String
  studentId    String?
  /// CONFIRMATION | REMINDER | PAYMENT | HALL_TICKET (older) | ENTRY_PASS
  kind         String
  /// AUTO (sent by the system) | MANUAL (sent by an admin)
  trigger      String   @default("AUTO")
  toEmail      String
  subject      String
  /// SENT | FAILED | NOT_CONFIGURED (no SMTP: logged to the server console instead)
  status       String
  error        String   @default("")
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, createdAt])
  @@index([tournamentId, studentId])
}

/// One emailed verification code. Kept in the database (not in memory) so the resend cooldowns and
/// per-email / per-IP limits hold across restarts and server processes. Only an HMAC of the code is stored.
model EmailOtpChallenge {
  id          String    @id @default(uuid())
  /// Normalised (trimmed, lower-case)
  email       String
  /// HMAC-SHA256 of the code, keyed with a server secret. The code itself is never stored or logged.
  codeHash    String
  /// Requesting IP, for the per-IP limits
  ip          String    @default("")
  expiresAt   DateTime
  /// Wrong (and right) guesses so far; the challenge locks at 5
  attempts    Int       @default(0)
  consumedAt  DateTime?
  /// Set when a newer code is sent to the same email: this one then stops working
  supersededAt DateTime?
  /// PENDING | SENT | FAILED | NOT_CONFIGURED. Failed sends don't count towards the limits.
  deliveryStatus String @default("PENDING")
  /// The mail server's Message-ID, to match against provider (Brevo) logs
  messageId   String    @default("")
  createdAt   DateTime  @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

/// Addresses we must not email: hard bounces, blocked or invalid recipients, spam complaints,
/// unsubscribes. Checked before every send; filled from SMTP rejections and the Brevo webhook.
model EmailSuppression {
  /// Normalised (trimmed, lower-case)
  email     String   @id
  /// HARD_BOUNCE | BLOCKED | INVALID | SPAM | UNSUBSCRIBED
  reason    String
  /// SMTP | BREVO_WEBHOOK | ADMIN
  source    String
  detail    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Permanent, append-only history of every change to a student record: who did it, when, and what
/// changed. The database refuses UPDATE, DELETE and TRUNCATE on this table (a trigger, see the
/// migration), so no one — not even an admin or the app itself — can edit or remove an entry.
model StudentAuditLog {
  id          String   @id @default(uuid())
  /// Not a foreign key: the history outlives the student record (deletions are logged too).
  studentId   String
  studentNo   String?
  studentName String
  /// CREATED | UPDATED | APPROVED | REJECTED | DELETED
  action      String
  /// ADMIN | STUDENT (registered themselves) | IMPORT (admin spreadsheet import)
  actorType   String
  /// Admin username, or the email the student registered with
  actor       String   @default("")
  /// For UPDATED: [{ field, label, from, to }] (Aadhaar numbers masked)
  changes     Json     @default("[]")
  /// e.g. the reason a registration was rejected
  note        String   @default("")
  /// Set by the database when the entry is written
  createdAt   DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([createdAt])
}
